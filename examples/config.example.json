      "aliases": ["Agent A"],
      "private_cwd": ".",
      "group_cwd": ".",
      "media_root": "examples/media/agent-a"
    },
    {
      "key": "agent-b",
      "token_env": "AGENT_B_TELEGRAM_BOT_TOKEN",
      "command": ["/usr/bin/python3", "examples/echo_agent.py", "Agent B"],
      "aliases": ["Agent B"],
      "private_cwd": ".",
      "group_cwd": ".",
      "media_root": "examples/media/agent-b"
    },
    {
      "key": "agent-c",
      "token_env": "AGENT_C_TELEGRAM_BOT_TOKEN",
      "command": ["/usr/bin/python3", "examples/echo_agent.py", "Agent C"],
      "aliases": ["Agent C"],
      "private_cwd": ".",
